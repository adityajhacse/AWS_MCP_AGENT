# Use lightweight Python 3.11
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y build-essential curl git && \
    rm -rf /var/lib/apt/lists/*

# Install uvx (ADK runtime) to run the MCP server
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Create Python virtual environment
RUN python3 -m venv /app/.venv

# Ensure both venv and uvx are in PATH
ENV PATH="/app/.venv/bin:/root/.local/bin:$PATH"

# Ensure Python output is unbuffered
ENV PYTHONUNBUFFERED=1

# Copy application files
COPY . .

# Install Python dependencies via uv (will create uv.lock if missing)
RUN uv sync --no-cache

# Expose FastAPI port
EXPOSE 8000

# Environment variable placeholders
ENV GOOGLE_API_KEY=""
ENV AWS_ACCESS_KEY_ID=""
ENV AWS_SECRET_ACCESS_KEY=""
ENV AWS_SESSION_TOKEN=""
ENV AWS_REGION="us-west-2"
ENV AWS_ENVIRONMENT="dev"
ENV ADK_MCP_REQUEST_TIMEOUT=60

RUN echo $ADK_MCP_REQUEST_TIMEOUT
RUN python3 -c "import os; print(float(os.environ.get('ADK_MCP_REQUEST_TIMEOUT', '5')))"

# Run ADK web server
CMD ["adk", "web", "--host", "0.0.0.0", "--port", "8000"]
