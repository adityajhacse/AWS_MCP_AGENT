# Lightweight Python base
FROM python:3.11-slim-bookworm

# Ensure non-interactive apt and faster, reliable installs
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.local/bin:${PATH}"



# Set environment variables placeholders
ENV GOOGLE_API_KEY=""
ENV AWS_ACCESS_KEY_ID=""
ENV AWS_SECRET_ACCESS_KEY=""
ENV AWS_REGION="us-west-2"
ENV AWS_ENVIRONMENT="dev"


WORKDIR /app


# System deps commonly needed (curl for uv install)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*


# Set environment variables placeholders
ENV GOOGLE_API_KEY=""
ENV AWS_ACCESS_KEY_ID=""
ENV AWS_SECRET_ACCESS_KEY=""
ENV AWS_REGION="us-west-2"
ENV AWS_ENVIRONMENT="dev"

# Install uv (for `uvx` used by MCP servers)    
RUN curl -LsSf https://astral.sh/uv/install.sh | sh




# Install Python deps
RUN python -m pip install --upgrade pip setuptools && \
    pip install google-adk 

# Copy project files
COPY . /app

# Default command: load the agent module; override at runtime as needed
# CMD ["python", "agent.py"]
CMD ["adk", "web", "--host", "0.0.0.0"]
# if running locally use this to connect to the agent http://127.0.0.1:8000/